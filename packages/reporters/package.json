{
  "name": "@worldready/reporters",
  "version": "0.1.0",
  "description": "WorldReady audit result reporters — JSON, Markdown, SARIF, console",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
