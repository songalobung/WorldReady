{
  "name": "worldready-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Internationalisation engineering for AI coding agents — Find it. Fix it. Prove it.",
  "keywords": ["i18n", "internationalisation", "internationalization", "rtl", "localization", "audit", "lint"],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "worldready": "pnpm --filter @worldready/cli exec worldready"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

